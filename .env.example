# ==============================================================================
# Tistory Multi-Blog Auto Publisher - Environment Variables
# ==============================================================================

# 1. Google Gemini AI API Key (Required)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Kakao Login Credentials (Required for Tistory Auto-Posting)
KAKAO_EMAIL=your_kakao_email@kakao.com
KAKAO_PASSWORD=your_kakao_password

# 3. Dashboard Master Password (Recommended - Restrict dashboard access to you only)
# If set, asks for username & password when opening dashboard URL
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_custom_secret_password

# 4. Server Port & Host
PORT=8000
HOST=0.0.0.0
TZ=Asia/Seoul

# 5. Render Keep-Alive URL (Set your Render URL to prevent sleep)
# e.g., https://tistory-auto.onrender.com
RENDER_EXTERNAL_URL=

# 6. Coupang Partners API (Optional - for auto affiliate link generation)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_TRACKING_ID=moocongpapa
