# ==============================================================================
# Tistory Multi-Blog Auto Publisher - Environment Variables
# ==============================================================================

# 1. Google Gemini AI API Key (Required)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Kakao Login Credentials (Required for Tistory Auto-Posting)
KAKAO_EMAIL=your_kakao_email@kakao.com
KAKAO_PASSWORD=your_kakao_password

# 3. Server Port (Default: 8000)
PORT=8000

# 4. Render Keep-Alive URL (Optional - Set your Render URL to prevent sleep)
# e.g., https://tistory-auto-publisher.onrender.com
RENDER_EXTERNAL_URL=

# 5. Coupang Partners API (Optional - for auto affiliate link generation)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_TRACKING_ID=
